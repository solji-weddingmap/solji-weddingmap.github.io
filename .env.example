# ---------------------------------------------------------------------------
# WEDDING MAP - Environment Variables
#
# 1. Copy this file to ".env" (never commit ".env" itself)
# 2. Fill in your real keys below
# 3. Restart `npm run dev` after changing this file
#
# The app works with mock data even if these are left blank / not filled in,
# so you can explore the UI before setting up Kakao Maps or Supabase.
# ---------------------------------------------------------------------------

# Kakao Maps JavaScript SDK key (NOT the REST API key!)
# Get it from https://developers.kakao.com -> 내 애플리케이션 -> 앱 키 -> JavaScript 키
VITE_KAKAO_MAP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# Supabase project URL and anon (public) key
# Get them from https://supabase.com/dashboard -> Project Settings -> API
# NEVER put the Service Role key here or anywhere in frontend code.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
